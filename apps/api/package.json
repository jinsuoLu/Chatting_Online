{
  "name": "@chatting/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node --env-file=../../.env dist/main.js",
    "test": "jest --runInBand",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@chatting/contracts": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/client": "^6.15.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "ioredis": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "prisma": "^6.15.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
