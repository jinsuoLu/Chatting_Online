NODE_ENV=production
APP_VERSION=0.1.0
POSTGRES_DB=chatting_online
POSTGRES_USER=chatting
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://chatting:replace-with-a-long-random-secret@postgres:5432/chatting_online?schema=public
REDIS_URL=redis://redis:6379
WEB_ORIGIN=https://chat.example.com
PUBLIC_APP_URL=https://chat.example.com
NEXT_PUBLIC_API_BASE_URL=https://chat.example.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://chat.example.com
CADDY_SITE=chat.example.com
ALLOW_INSECURE_HTTP=false
MESSAGE_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=14
BACKUP_ALERT_EMAIL=ops@example.com
BACKUP_ALERT_WEBHOOK=
